{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Tests",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/tests/test_order_flow.js",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"env": {
				"NODE_ENV": "development"
			}
		},
		{
			"name": "Debug Bundle",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/scripts/bundle.js",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		}
	]
}